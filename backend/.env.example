# ── App ──────────────────────────────────────────────
APP_NAME=MaidKaro API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://maidkaro:maidkaro@localhost:5432/maidkaro
# For local testing without Postgres installed, SQLAlchemy also accepts:
# DATABASE_URL=sqlite:///./maidkaro_dev.db

# ── Redis / Celery ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Security ─────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-64-char-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ADMIN_JWT_SECRET_KEY=change-this-separately-for-admin-tokens

# ── OTP / SMS ────────────────────────────────────────
SMS_PROVIDER=dev_logger
MSG91_API_KEY=
MSG91_SENDER_ID=MAIDKR
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ── Payments (Razorpay) ──────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Object storage (KYC docs, photos) ────────────────
S3_ENDPOINT_URL=
S3_BUCKET=maidkaro-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1
S3_SIGNED_URL_EXPIRY_SECONDS=600

# ── Safety / Trust ───────────────────────────────────
SAFETY_ESCALATION_PHONE=+91XXXXXXXXXX
EXOTEL_SID=
EXOTEL_TOKEN=
EXOTEL_VIRTUAL_NUMBER=

# ── CORS ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
