// MaidKaro — Prisma schema (PostgreSQL)
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  WORKER
  ADMIN
  SUPER_ADMIN
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  APPROVED
  REJECTED
  NEEDS_RESUBMISSION
}

enum DocumentType {
  GOVERNMENT_ID
  ADDRESS_PROOF
  PROFILE_PHOTO
  POLICE_VERIFICATION
  OTHER
}

enum BookingType {
  INSTANT
  SCHEDULED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
  EXPIRED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  PROCESSED
  FAILED
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum ComplaintRaisedBy {
  CUSTOMER
  WORKER
}

enum NotificationChannel {
  PUSH
  SMS
  IN_APP
}

enum WeekDay {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

// ──────────────────────────────────────────────────────────────
// IDENTITY / AUTH
// ──────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  phone        String   @unique // E.164, e.g. +91XXXXXXXXXX
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customerProfile CustomerProfile?
  workerProfile   WorkerProfile?
  adminProfile    AdminProfile?

  otpCodes        OtpCode[]
  refreshTokens   RefreshToken[]
  notifications   Notification[]
  supportTickets  SupportTicket[] @relation("TicketRaisedBy")

  @@index([role])
}

model OtpCode {
  id        String   @id @default(uuid())
  userPhone String
  codeHash  String
  purpose   String   // "LOGIN" | "SIGNUP"
  expiresAt DateTime
  consumedAt DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userPhone], references: [phone])

  @@index([userPhone])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ──────────────────────────────────────────────────────────────
// CUSTOMER
// ──────────────────────────────────────────────────────────────

model CustomerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  email       String?
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  addresses   CustomerAddress[]
  bookings    Booking[]
  reviews     Review[]
  favorites   FavoriteWorker[]
}

model CustomerAddress {
  id          String   @id @default(uuid())
  customerId  String
  customer    CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label       String   // "Home", "Office", ...
  line1       String
  line2       String?
  pincodeId   String
  pincode     Pincode  @relation(fields: [pincodeId], references: [id])
  latitude    Float
  longitude   Float
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  bookings    Booking[]

  @@index([pincodeId])
}

model FavoriteWorker {
  id          String   @id @default(uuid())
  customerId  String
  customer    CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workerId    String
  worker      WorkerProfile   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([customerId, workerId])
}

// ──────────────────────────────────────────────────────────────
// WORKER
// ──────────────────────────────────────────────────────────────

model WorkerProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String
  photoUrl           String?
  bio                String?
  cityId             String
  city               City     @relation(fields: [cityId], references: [id])
  serviceZoneId      String?
  serviceZone        ServiceZone? @relation(fields: [serviceZoneId], references: [id])
  languages          String[] // ["Bengali","Hindi","English"]
  yearsExperience    Int      @default(0)
  verificationStatus VerificationStatus @default(NOT_SUBMITTED)
  verificationNote   String?  // admin reason on reject/resubmit
  ratingAvg          Float    @default(0)
  ratingCount        Int      @default(0)
  isAvailableNow     Boolean  @default(false) // toggled by worker for INSTANT matching
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  skills             WorkerSkill[]
  documents          KycDocument[]
  availability       AvailabilitySlot[]
  bookings           Booking[]
  reviews            Review[]
  favoritedBy        FavoriteWorker[]
  payoutEntries      PayoutLedgerEntry[]
  payoutRequests     Payout[]

  @@index([cityId, verificationStatus, isAvailableNow])
  @@index([serviceZoneId])
}

model WorkerSkill {
  id         String   @id @default(uuid())
  workerId   String
  worker     WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id])
  hourlyRate Decimal? @db.Decimal(10, 2) // overrides category base rate if set

  @@unique([workerId, categoryId])
  @@index([categoryId])
}

model KycDocument {
  id           String   @id @default(uuid())
  workerId     String
  worker       WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  type         DocumentType
  fileUrl      String   // private object-storage key, served via signed URL
  status       VerificationStatus @default(PENDING_REVIEW)
  reviewedById String?
  reviewedAt   DateTime?
  rejectReason String?
  createdAt    DateTime @default(now())

  @@index([workerId])
}

model AvailabilitySlot {
  id        String   @id @default(uuid())
  workerId  String
  worker    WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  day       WeekDay
  startTime String   // "09:00"
  endTime   String   // "18:00"

  @@index([workerId])
}

// ──────────────────────────────────────────────────────────────
// CATALOG (services, cities, zones)
// ──────────────────────────────────────────────────────────────

model ServiceCategory {
  id             String   @id @default(uuid())
  name           String   @unique // "Kitchen Help", "Home Cleaning", ...
  slug           String   @unique
  description    String
  iconUrl        String?
  baseHourlyRate Decimal  @db.Decimal(10, 2)
  commissionPct  Decimal  @db.Decimal(5, 2) @default(15.00)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)

  workerSkills   WorkerSkill[]
  bookings       Booking[]
  cityAvailability CityCategory[]
}

model City {
  id        String   @id @default(uuid())
  name      String   @unique // "Siliguri"
  state     String   // "West Bengal"
  isActive  Boolean  @default(true)
  launchedAt DateTime @default(now())

  zones     ServiceZone[]
  workers   WorkerProfile[]
  categories CityCategory[]
}

model CityCategory {
  id         String   @id @default(uuid())
  cityId     String
  city       City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isActive   Boolean  @default(true)

  @@unique([cityId, categoryId])
}

model ServiceZone {
  id        String   @id @default(uuid())
  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name      String   // "Siliguri - Sevoke Road"
  isActive  Boolean  @default(true)

  pincodes  Pincode[]
  workers   WorkerProfile[]

  @@index([cityId])
}

model Pincode {
  id            String   @id @default(uuid())
  code          String   @unique // "734001"
  serviceZoneId String
  serviceZone   ServiceZone @relation(fields: [serviceZoneId], references: [id], onDelete: Cascade)

  addresses     CustomerAddress[]

  @@index([serviceZoneId])
}

// ──────────────────────────────────────────────────────────────
// BOOKINGS
// ──────────────────────────────────────────────────────────────

model Booking {
  id            String   @id @default(uuid())
  customerId    String
  customer      CustomerProfile @relation(fields: [customerId], references: [id])
  workerId      String?
  worker        WorkerProfile? @relation(fields: [workerId], references: [id])
  categoryId    String
  category      ServiceCategory @relation(fields: [categoryId], references: [id])
  addressId     String
  address       CustomerAddress @relation(fields: [addressId], references: [id])
  type          BookingType
  status        BookingStatus @default(PENDING)
  scheduledFor  DateTime?     // required for SCHEDULED
  durationHours Decimal       @db.Decimal(4, 1)
  priceQuoted   Decimal       @db.Decimal(10, 2)
  notes         String?
  cancelReason  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  confirmedAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?

  payment       Payment?
  review        Review?
  complaints    Complaint[]
  statusEvents  BookingStatusEvent[]

  @@index([customerId])
  @@index([workerId])
  @@index([status])
}

// Immutable audit trail of every status transition (trust & support tooling)
model BookingStatusEvent {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus BookingStatus?
  toStatus  BookingStatus
  actor     String   // userId or "SYSTEM"
  note      String?
  createdAt DateTime @default(now())

  @@index([bookingId])
}

// ──────────────────────────────────────────────────────────────
// PAYMENTS
// ──────────────────────────────────────────────────────────────

model Payment {
  id                String   @id @default(uuid())
  bookingId         String   @unique
  booking           Booking  @relation(fields: [bookingId], references: [id])
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  amount            Decimal  @db.Decimal(10, 2)
  currency          String   @default("INR")
  status            PaymentStatus @default(CREATED)
  refundedAmount    Decimal  @db.Decimal(10, 2) @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
}

model PayoutLedgerEntry {
  id            String   @id @default(uuid())
  workerId      String
  worker        WorkerProfile @relation(fields: [workerId], references: [id])
  bookingId     String
  grossAmount   Decimal  @db.Decimal(10, 2)
  commissionAmount Decimal @db.Decimal(10, 2)
  netAmount     Decimal  @db.Decimal(10, 2)
  isPaidOut     Boolean  @default(false)
  payoutId      String?
  payout        Payout?  @relation(fields: [payoutId], references: [id])
  createdAt     DateTime @default(now())

  @@index([workerId, isPaidOut])
}

model Payout {
  id                String   @id @default(uuid())
  workerId          String
  worker            WorkerProfile @relation(fields: [workerId], references: [id])
  amount            Decimal  @db.Decimal(10, 2)
  status            PayoutStatus @default(REQUESTED)
  razorpayPayoutId  String?
  failureReason     String?
  requestedAt       DateTime @default(now())
  processedAt       DateTime?

  ledgerEntries     PayoutLedgerEntry[]

  @@index([workerId, status])
}

// ──────────────────────────────────────────────────────────────
// REVIEWS
// ──────────────────────────────────────────────────────────────

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id])
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id])
  workerId   String
  worker     WorkerProfile @relation(fields: [workerId], references: [id])
  rating     Int      // 1-5
  comment    String?
  createdAt  DateTime @default(now())

  @@index([workerId])
}

// ──────────────────────────────────────────────────────────────
// SUPPORT / TRUST & SAFETY
// ──────────────────────────────────────────────────────────────

model SupportTicket {
  id          String   @id @default(uuid())
  raisedById  String
  raisedBy    User     @relation("TicketRaisedBy", fields: [raisedById], references: [id])
  subject     String
  message     String
  status      ComplaintStatus @default(OPEN)
  createdAt   DateTime @default(now())

  messages    SupportMessage[]
}

model SupportMessage {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String   // userId, could be admin
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model Complaint {
  id           String   @id @default(uuid())
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id])
  raisedBy     ComplaintRaisedBy
  raisedByUserId String
  description  String
  status       ComplaintStatus @default(OPEN)
  resolutionNote String?
  refundIssued Decimal? @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?

  @@index([bookingId])
  @@index([status])
}

// ──────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ──────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   // "android" | "ios"
  createdAt DateTime @default(now())

  @@index([userId])
}

// ──────────────────────────────────────────────────────────────
// ADMIN
// ──────────────────────────────────────────────────────────────

model AdminProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model PlatformSetting {
  key       String   @id // "default_commission_pct", "otp_expiry_seconds", ...
  value     String
  updatedAt DateTime @updatedAt
}
